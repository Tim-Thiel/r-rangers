RewriteEngine On

# Extensionless URLs: /bereiche/aktionen -> bereiche/aktionen.html
# Kein !-d Check, da Ordner und Dateien gleichen Namens existieren (z.B. bereiche/aktionen/ und bereiche/aktionen.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]
