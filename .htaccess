RewriteEngine On

# Trailing Slash: /bereiche/aktionen/ -> /bereiche/aktionen.html (wenn gleichnamige .html existiert)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1.html [R=301,L]

# Kein Extension: /bereiche/aktionen -> bereiche/aktionen.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]
